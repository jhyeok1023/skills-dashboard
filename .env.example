# Copy to .env and fill in. The file is read at start-up and never written to.
#
# The key needs read-only access to CloudWatch metrics and logs, plus the List
# and Describe calls the settings page uses for discovery:
#
#   cloudwatch:GetMetricData
#   logs:StartQuery, logs:GetQueryResults, logs:StopQuery, logs:DescribeLogGroups
#   sts:GetCallerIdentity
#   elasticloadbalancing:DescribeTargetGroups, DescribeLoadBalancers
#   rds:DescribeDBProxies
#   wafv2:ListWebACLs
#   eks:ListClusters, eks:ListNodegroups, eks:DescribeNodegroup

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2

# Only needed for temporary credentials.
# AWS_SESSION_TOKEN=
