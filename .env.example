# Copy to .env and fill in. The file is read at start-up and never written to.
#
# The binary looks for it beside itself first, then in ~/.skills-dashboard/
# (where config.json lives). It does not look in the working directory: where
# the key lives is a property of the install, not of where you happened to be
# when you started it. Anything not found in the file falls back to the process
# environment, which is how `mise run` supplies these during development.
#
# The key needs read-only access to CloudWatch metrics and logs, plus the List
# and Describe calls the settings page uses for discovery:
#
#   cloudwatch:GetMetricData
#   logs:StartQuery, logs:GetQueryResults, logs:StopQuery, logs:DescribeLogGroups
#   sts:GetCallerIdentity
#   elasticloadbalancing:DescribeTargetGroups, DescribeLoadBalancers
#   rds:DescribeDBProxies
#   wafv2:ListWebACLs
#   eks:ListClusters, eks:ListNodegroups, eks:DescribeNodegroup

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2

# Only needed for temporary credentials.
# AWS_SESSION_TOKEN=
