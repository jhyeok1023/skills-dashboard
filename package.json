{
	"name": "skills-dashboard",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "EKS 워크로드 모니터링 대시보드 — node 로 실행하는 런처",
	"scripts": {
		"start": "node start.mjs",
		"dev": "node scripts/dev.mjs",
		"install:web": "npm --prefix web ci",
		"install:server": "npm --prefix server ci",
		"build:web": "npm --prefix web run build",
		"build:server": "npm --prefix server run build",
		"check": "npm --prefix web run check",
		"lint": "npm --prefix web run lint",
		"format": "npm --prefix web run format",
		"parity": "node scripts/parity.mjs",
		"test": "npm --prefix web run test:unit -- --run",
		"test:e2e": "npm --prefix web run test:e2e"
	}
}
